          {
            "id": "cls-0007",
            "role": "Senior Financial Analyst",
            "company": "Harrow & Lane Retail Group",
            "location": "London",
            "link": "",
            "start": "2021-03",
            "end": null,
            "current": true,
            "description": "<ul><li>Own the rolling 18-month forecast for the UK stores division (£1.2bn revenue, 240 sites).</li><li>Rebuilt the store-level P&amp;L model in Power BI, which replaced 31 spreadsheets and saves the team about 40 hours a month.</li><li>Shortened the month-end close from 8 to 4 working days by automating accrual reconciliations.</li><li>Prepare the quarterly board pack and present variance analysis to the CFO.</li></ul>"
          },
          {
            "id": "cls-0008",
            "role": "Financial Analyst",
            "company": "Northgate Logistics",
            "location": "Manchester",
            "link": "",
            "start": "2018-01",
            "end": "2021-02",
            "current": false,
            "description": "<ul><li>Built the capital expenditure appraisal model used for a £45m warehouse automation programme.</li><li>Partnered with operations on cost-to-serve analysis, which identified £3.1m of annual savings.</li><li>Introduced driver-based budgeting for fleet costs and cut forecast error from 9% to 3%.</li></ul>"
          },
