      {
        "id": "tml-0005",
        "type": "summary",
        "title": "Summary",
        "column": "main",
        "pageBreakBefore": false,
        "settings": {},
        "items": [
          {
            "id": "tml-0006",
            "text": "<p>Hydrologist with twelve years of research on flood forecasting, river basin modelling and climate adaptation in West Africa and Northern Europe. I lead interdisciplinary teams, have secured €4.8m in competitive funding, and work closely with water authorities so that research turns into early-warning systems people rely on.</p>"
          }
        ]
      },
      {
        "id": "tml-0007",
        "type": "experience",
        "title": "Experience",
        "column": "main",
        "pageBreakBefore": false,
        "settings": {
          "showDates": true,
          "showLocation": true,
          "showLink": true,
          "showDescription": true
        },
        "items": [
          {
            "id": "tml-0008",
            "role": "Senior Research Scientist",
            "company": "Delta Institute for Water Research",
            "location": "Amsterdam",
            "link": "",
            "start": "2020-09",
            "end": null,
            "current": true,
            "description": "<ul><li>Lead the Flood Resilience group (4 postdocs, 6 PhD students, 2 engineers).</li><li>Principal investigator on the EU Horizon project RIVERSENSE (€2.9m, 11 partners in 7 countries).</li><li>Developed an ensemble flood forecasting model now run operationally by two national agencies.</li><li>Built a data partnership with the Niger Basin Authority that gives researchers access to 40 years of gauge records.</li><li>Teach the graduate course “Hydrological Modelling under Uncertainty” (60 students a year).</li></ul>"
          },
          {
            "id": "tml-0009",
            "role": "Postdoctoral Researcher",
            "company": "University of Utrecht, Department of Physical Geography",
            "location": "Utrecht",
            "link": "",
            "start": "2017-01",
            "end": "2020-08",
            "current": false,
            "description": "<ul><li>Coupled land-surface and river-routing models to study compound flooding in deltas.</li><li>Published 9 peer-reviewed papers, including two in Nature Communications.</li><li>Co-supervised 3 PhD students, all of whom finished on time.</li><li>Organised the 2019 European Hydrology Summer School (120 participants).</li></ul>"
          },
          {
            "id": "tml-0010",
            "role": "Doctoral Researcher",
            "company": "Imperial College London",
            "location": "London",
            "link": "",
            "start": "2013-10",
            "end": "2016-12",
            "current": false,
            "description": "<ul><li>Thesis: “Data-sparse flood forecasting for the Niger River using satellite rainfall”.</li><li>Ran three field campaigns in Mali and Niger to install and calibrate river gauges.</li><li>Taught undergraduate labs in fluid mechanics and GIS.</li></ul>"
          },
          {
            "id": "tml-0011",
            "role": "Water Resources Engineer",
            "company": "Sahel Water Partners",
            "location": "Niamey, Niger",
            "link": "",
            "start": "2010-03",
            "end": "2013-08",
            "current": false,
            "description": "<ul><li>Designed small irrigation and water-harvesting schemes for 18 rural communities.</li><li>Trained 40 local technicians in gauge maintenance and data collection.</li><li>Wrote the technical reports that secured follow-on funding from two NGOs.</li></ul>"
          }
        ]
      },
